<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LiaAI" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">#06050E</item>
        <item name="android:navigationBarColor">#06050E</item>
        <item name="android:windowBackground">#06050E</item>
    </style>

    <!-- Splash screen theme required by androidx.core:core-splashscreen -->
    <style name="Theme.LiaAI.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#06050E</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">#1A1830</item>
        <item name="postSplashScreenTheme">@style/Theme.LiaAI</item>
    </style>
</resources>
